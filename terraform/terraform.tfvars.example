# Copy this file to terraform.tfvars.
# terraform.tfvars is ignored by Git.

aws_region         = "us-east-1"
vpc_cidr           = "10.127.0.0/16"
public_subnet_cidr = "10.127.1.0/24"

# Leave null to let AWS select the Availability Zone.
availability_zone = null

instance_type    = "t3.large"
key_name         = "REPLACE_WITH_YOUR_EC2_KEY_PAIR_NAME"
root_volume_size = 30

# Replace with your current public IPv4 address in CIDR notation.
# Example:
# admin_cidr = "203.0.113.25/32"
admin_cidr = "REPLACE_WITH_YOUR_PUBLIC_IP/32"

# The EC2 bootstraps the stable laboratory branch.
project_branch = "main"
repo_url       = "https://github.com/irtaza400/exam-final-repo.git"
