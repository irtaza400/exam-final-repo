"""Import Topic127 OPC-UA tags into FUXA device."""

from __future__ import annotations

import json
import urllib.request


FUXA_URL = "http://127.0.0.1:1881"

DEVICE_ID = "d_598f1c2f-8c5748c5"


TAGS = {
    "RecipeID": {
        "id": "ns=2;i=2",
        "name": "RecipeID",
        "label": "RecipeID",
        "type": "string",
        "address": "ns=2;i=2",
    },
    "ProcessName": {
        "id": "ns=2;i=3",
        "name": "ProcessName",
        "label": "ProcessName",
        "type": "string",
        "address": "ns=2;i=3",
    },
    "TemperatureSetpoint": {
        "id": "ns=2;i=4",
        "name": "TemperatureSetpoint",
        "label": "TemperatureSetpoint",
        "type": "number",
        "address": "ns=2;i=4",
    },
    "PressureSetpoint": {
        "id": "ns=2;i=5",
        "name": "PressureSetpoint",
        "label": "PressureSetpoint",
        "type": "number",
        "address": "ns=2;i=5",
    },
    "EtchTimeSeconds": {
        "id": "ns=2;i=6",
        "name": "EtchTimeSeconds",
        "label": "EtchTimeSeconds",
        "type": "number",
        "address": "ns=2;i=6",
    },
    "MachineStatus": {
        "id": "ns=2;i=7",
        "name": "MachineStatus",
        "label": "MachineStatus",
        "type": "string",
        "address": "ns=2;i=7",
    },
    "SecurityState": {
        "id": "ns=2;i=8",
        "name": "SecurityState",
        "label": "SecurityState",
        "type": "string",
        "address": "ns=2;i=8",
    },
    "MachineStatusCode": {
        "id": "ns=2;i=9",
        "name": "MachineStatusCode",
        "label": "MachineStatusCode",
        "type": "number",
        "address": "ns=2;i=9",
    },
    "SecurityStateCode": {
        "id": "ns=2;i=10",
        "name": "SecurityStateCode",
        "label": "SecurityStateCode",
        "type": "number",
        "address": "ns=2;i=10",
    },
}


def request(method, url, payload=None):

    data = None
    headers = {}

    if payload:
        data = json.dumps(payload).encode()
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(
        url,
        data=data,
        headers=headers,
        method=method,
    )

    with urllib.request.urlopen(req) as r:
        return json.loads(r.read())


project = request(
    "GET",
    f"{FUXA_URL}/api/project"
)


device = project["devices"][DEVICE_ID]


device["tags"] = TAGS


payload = {
    "cmd": "set-device",
    "data": device,
}


response = request(
    "POST",
    f"{FUXA_URL}/api/project"
    payload,
)


print("FUXA OPC-UA tag import completed")
print("Device:", device["name"])
print("Tags:", len(TAGS))
print(response)
